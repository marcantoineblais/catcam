# Public URL of this app (no trailing slash)
# Examples: http://localhost:3000, https://catcam.example.com
DOMAIN_NAME=http://localhost:3000

# Base URL of your Shinobi (or compatible) API (no trailing slash)
SERVER_URL=https://your-shinobi-api.example.com

# Optional: timezone the Shinobi server records video times in (IANA name, default UTC)
# SERVER_TIMEZONE=America/Toronto

# Secret used to sign session JWTs (e.g. base64 or random string)
# Generate one with: openssl rand -base64 32
JWT_SIGN_SECRET=your-jwt-secret-here

# Secret used for CSRF tokens
# Generate one with: openssl rand -base64 32
CSRF_TOKEN_SECRET=your-csrf-secret-here

# Port the app listens on
PORT=3000

# Optional: path for persisted user settings (used with Docker volume)
# USER_SETTINGS_PATH=/data/user-settings
